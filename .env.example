# No credentials are needed for ordinary desktop development or offline play.
# Copy this file to .env only for optional speech generation.
# Empty credentials are intentional placeholders. Never commit real values.
# pnpm tts:generate loads the root .env explicitly.

# Required only when generating Azure AI Speech audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional voice overrides. Leave commented to use automatic selection.
# TTS_VOICE_BN=bn-BD-NabanitaNeural
# TTS_VOICE_EN=en-US-AnaNeural

# Other build tools read the shell environment, not this file automatically.
# Export these settings in PowerShell, your terminal, or CI when needed.
# WASM_BINDGEN=C:/tools/wasm-bindgen.exe
# VITE_CACHE_DIR=node_modules/.vite
# SHOT_DIR=test-results/manual-screenshots
# ANDROID_HOME=C:/path/to/Android/Sdk
# ANDROID_SDK_ROOT=C:/path/to/Android/Sdk
# JAVA_HOME=C:/path/to/jdk

# Release-only placeholders. Store actual values as GitHub Actions secrets.
# RELEASES_TOKEN=
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# The release action receives GITHUB_TOKEN from RELEASES_TOKEN.
# Vite's DEV, Windows USERPROFILE, and the Formula CARGO_TARGET_DIR are managed.
# Never put credentials in VITE_* variables, which can reach browser code.
