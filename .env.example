# Copy to .env (git-ignored) and fill in. Used only by developer scripts, never shipped in the app.

# Azure AI Speech (free tier F0): portal.azure.com > Create resource > Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Optional: pin voices (otherwise the script picks bn-BD female / en-US child voice)
# TTS_VOICE_BN=bn-BD-NabanitaNeural
# TTS_VOICE_EN=en-US-AnaNeural
