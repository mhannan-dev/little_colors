{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Counter Rush",
  "version": "0.1.0",
  "identifier": "dev.counterrush.kitchen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Counter Rush", "width": 1120, "height": 760, "minWidth": 680, "minHeight": 500 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false }
}
