{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests --dir src",
    "test:e2e": "playwright test e2e",
    "ui:shots": "playwright test gallery --workers=1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@little-colors/core": "workspace:*",
    "@little-colors/design-tokens": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
